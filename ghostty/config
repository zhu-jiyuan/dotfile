

theme = iTerm2 Solarized Light
#keybind=clear

# Let terminal applications such as Codex handle Ctrl+Enter.
keybind = ctrl+enter=unbind
# Keep fullscreen available without taking Codex's multiline shortcut.
keybind = f11=toggle_fullscreen

mouse-hide-while-typing = true
font-family             = "JetBrainsMono Nerd Font Mono"
font-size               = 14

cursor-style = block
cursor-style-blink = true
custom-shader = ~/dotfile/ghostty/shaders/cursor_warp.glsl
custom-shader-animation = always

clipboard-read = allow

clipboard-write = allow
app-notifications = no-clipboard-copy
macos-titlebar-style = transparent

gtk-titlebar = false
gtk-wide-tabs= false


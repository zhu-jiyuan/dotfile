

theme = Notebook Paper
# Ruled notebook paper. The red margin is a background tile inside the left padding; the rules
# come from a shader that reads the cell height off the cursor, so they follow any font size.
background-image = ~/.config/ghostty/notebook-paper.png
background-image-position = top-left
background-image-fit = none
background-image-repeat = true
window-padding-x = 22,2
custom-shader = ~/.config/ghostty/shaders/notebook-rules.glsl
# The rules never move, so redraw only when the terminal changes.
custom-shader-animation = false
#keybind=clear

# Send Ctrl+J for newline in Codex and Claude Code.
keybind = ctrl+enter=text:\n
# Keep fullscreen available without taking Codex's multiline shortcut.
keybind = f11=toggle_fullscreen

mouse-hide-while-typing = true
# Use Ghostty's built-in JetBrains Mono (default font).
font-size               = 19

# Keep CJK characters and punctuation on macOS PingFang SC.
font-codepoint-map = U+3000-U+303F=PingFang SC
font-codepoint-map = U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF=PingFang SC
font-codepoint-map = U+FF00-U+FFEF=PingFang SC

cursor-style = block
cursor-style-blink = true

clipboard-read = allow
clipboard-write = allow
app-notifications = no-clipboard-copy
macos-titlebar-style = transparent
macos-option-as-alt = true

gtk-titlebar = false
gtk-wide-tabs= false

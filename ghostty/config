

theme = iTerm2 Solarized Light
#keybind=clear

# Send Ctrl+J for newline in Codex and Claude Code.
keybind = ctrl+enter=text:\n
# Keep fullscreen available without taking Codex's multiline shortcut.
keybind = f11=toggle_fullscreen

mouse-hide-while-typing = true
# Use Ghostty's built-in JetBrains Mono (default font).
font-size               = 14

# Keep CJK characters and punctuation on macOS PingFang SC.
font-codepoint-map = U+3000-U+303F=PingFang SC
font-codepoint-map = U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF=PingFang SC
font-codepoint-map = U+FF00-U+FFEF=PingFang SC

cursor-style = block
cursor-style-blink = true
# Disabled while diagnosing cursor jumps: the shader draws a second moving block.
# custom-shader = ~/dotfile/ghostty/shaders/cursor_warp.glsl
# custom-shader-animation = always

clipboard-read = allow

clipboard-write = allow
app-notifications = no-clipboard-copy
macos-titlebar-style = transparent
macos-option-as-alt = true

gtk-titlebar = false
gtk-wide-tabs= false
